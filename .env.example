# TokenHub 环境变量示例 — 复制为 .env 后按需修改(mise 任务会自动加载 .env)
# 所有变量均可选:留空或删除整行则使用 internal/config 的内置默认值

# HTTP 监听端口(默认 8080)
PORT=8080

# SQLite 数据库路径(默认 data/tokenhub.db)
DB_PATH=data/tokenhub.db

# JWT 签名密钥;留空则首次启动自动生成并持久化到 settings 表
JWT_SECRET=

# 管理员账号,仅在首次启动 seed 时生效(默认 admin/admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 请求体大小上限,单位 MB(默认 20)
BODY_LIMIT_MB=20
